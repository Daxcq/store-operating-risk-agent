# ==============================================================================
# 成员 C：第三方大模型 API 配置（严格遵循《上下文与 KV Cache 约束》）
# ==============================================================================

# 1. 协议类型：
# - openai-compatible : 支持阶跃星辰 StepFun / DeepSeek / 通义千问 / 硅基流动 / OpenAI / OneAPI 等
# - anthropic         : 支持 Anthropic Claude 原生 /v1/messages 接口
LLM_PROVIDER=openai-compatible

# 2. 第三方 API 基础地址（自动支持将 https://platform.stepfun.com/step-plan 映射为 https://api.stepfun.com/step_plan/v1）
LLM_BASE_URL=https://platform.stepfun.com/step-plan

# 3. 第三方 API 密钥
LLM_API_KEY=3lz093nq8zbClyisHW9pqj9trmVPo5mBsDGZLlfrv76iUFYn5OUolMNNX9CNc83AT

# 4. 模型名称（自动支持将 "stepfun5 preview" 映射为官方模型 ID "step-5-preview"）
LLM_MODEL=stepfun5 preview

# 5. 请求超时毫秒数
LLM_TIMEOUT_MS=45000

# Agent 主动监控通知（可选）
# QQ 邮箱 SMTP 使用邮箱账号和授权码，不使用 QQ 登录密码。
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_SECURE=true
QQ_SMTP_USER=
QQ_SMTP_AUTH_CODE=
AGENT_NOTIFY_EMAIL_TO=
# 可选的通用 Webhook 通道
AGENT_NOTIFY_WEBHOOK_URL=

# =============================================================================
# 数据层配置模板 —— 复制成 .env 后填入真实值
#
#   cp .env.supabase.example .env
#
# 为什么单独一份模板而不是改 .env.example：
#   .env.example 里已经有一个真实格式的 LLM_API_KEY 被提交进了公开仓库，
#   那个文件不在本次改动范围内。数据层需要的变量写在独立模板里，互不干扰。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、建库用（只有 supabase/deploy.py 需要，跑完可以删）
# -----------------------------------------------------------------------------

# PostgreSQL 直连串。建表必须用它：PostgREST 只能操作数据，不能执行 DDL。
# 取法：Supabase 后台 -> Project Settings -> Database -> Connection string -> URI
#
# 务必用端口 5432（Direct connection 或 Session pooler）。
# 不要用 6543（Transaction pooler）—— 它不支持 init.sql 里的部分语句。
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres


# -----------------------------------------------------------------------------
# 二、运行时用（Python 数据层读，常驻）
# -----------------------------------------------------------------------------

# 项目 URL，形如 https://<project-ref>.supabase.co
SUPABASE_URL=

# service_role key。写 tasks_and_traces / trace_events 必须有它。
# 用 anon key 时 RLS 会拦下写操作，而且是静默失败——务必用 service_role。
#
# 安全提醒：这个 key 绕过所有行级安全策略，等同数据库超级权限。
# 只能放在服务端（Python 进程）的环境变量里，绝不能进前端代码、
# 不能提交到仓库、不能写进任何会被浏览器读到的文件。
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 三、业务开关（都有合理默认值，不填也能跑）
# -----------------------------------------------------------------------------

# 数据版本号。必须与 init.sql 里写入的 data_version 一致，否则读不到数据。
DATA_VERSION=demo_v1

# openFindingCount 的口径：
#   contract_snapshot（默认）
#       固定返回契约快照的 3，与 PROJECT.md §10 的验收数字严格一致。
#   rule_derived
#       按 knowledge_wiki 的规则实算，返回命中的条数。
#
# 为什么需要这个开关：规则实算会多出一条 E 店发现（订单 -14.0% 命中
# order_drop_watch），而契约快照里只有 3 条。两者数量恰好都是 3，所以
# 从数字上看不出差别。详见 docs/DEPLOYMENT.md §5。
OPEN_FINDINGS_MODE=contract_snapshot

# 数据不足时（可比门店 <3、关键字段缺失、数据版本不一致）：
#   false（默认）—— 返回 status='insufficient'/'unavailable' 的降级结果，
#                   前端仍能渲染，由人工判断。
#   true         —— 直接抛 INSUFFICIENT_DATA（HTTP 422），让调用方立即失败。
# 演示时建议保持 false：降级路径本身就是要展示的能力之一。
STRICT_INSUFFICIENT=false

# DataContext 进程级缓存时长（秒）。Agent 一轮常连调 2~4 个工具，缓存省掉重复全表读。
# 设 0 关闭缓存：改完库立即生效，对数据时用这个值。
CONTEXT_TTL_SECONDS=15

# 注意：可比门店数下限 MIN_PEER_COUNT 目前【不是】环境变量，
# 它是 data_layer/config.py 里的模块常量，改动需要改代码：
#     MIN_PEER_COUNT = 3
# 写在这里只是告知默认口径，填进 .env 不会生效。


# -----------------------------------------------------------------------------
# 四、Node 桥接层（src/server/，可选）
# -----------------------------------------------------------------------------

# Python 数据层地址
DATA_LAYER_URL=http://127.0.0.1:8787

# 单次调用超时（毫秒）。超时即回退内存实现，不让页面等。
DATA_LAYER_TIMEOUT=3500

# 设为 0 可完全关闭桥接，只走 src/agent/components/defaultDomainServices.js
# 的内存实现（不需要 Python 服务也能演示前端）
DATA_LAYER_ENABLED=1
